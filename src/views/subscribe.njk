{% from "blocks/header.njk" import header with context %}
{% from "blocks/footer.njk" import footer with context %}

{{ header(
  title=title,
  isLogoContrastColor=isLogoContrastColor
) }}

<main class="subscribe-page standalone-page" id="main-content">
  <div class="standalone-page__header">
    <div class="standalone-page__wrapper">
      <h1 class="standalone-page__title">
        Doka newsletter
      </h1>
    </div>
  </div>
  <div class="standalone-page__content standalone-page__wrapper content">
    <p>Doka is a guide to the web platform. Find answers to everyday questions in the reference, and explore themed collections, expert tips, guest columns, and partner articles in our newsletters.</p>
    <p>Subscribe here and tell us a little about yourself so we can tailor the newsletter to your interests.</p>
    <p>📨 <a href="/newsletters/">Newsletter archive</a></p>

    <form class="subscribe-page__subscribe subscribe-settings form-with-status" aria-labelledby="subscribe-label">
      <h2 class="subscribe-settings__title" id="subscribe-label">Set up your newsletter</h2>
      <div class="subscribe-settings__row">
        <input type="hidden" name="active" value="false">
        <input class="subscribe-settings__input" type="email" name="email" placeholder="dog@doka.guide" inputmode="email" id="email" inputmode="email" autocomplete="email" pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$" required>
        <label for="email" class="subscribe-settings__hint">Your email (required)</label>
      </div>
      <div class="subscribe-settings__row">
        <fieldset class="subscribe-settings__fieldset">
          <legend class="subscribe-settings__label">How are you involved in web development?</legend>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="who" value="front" id="frontenddev">
            Front-end developer
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="who" value="back" id="backenddev">
            Back-end developer
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="who" value="full" id="fullstack">
            Full-stack developer
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="who" value="designer" id="artist">
            Designer
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="who" value="qa" id="tester">
            QA
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="who" value="devops" id="devoops">
            DevOps engineer
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="who" value="devrel" id="architect">
            Developer relations
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="who" value="teamlead" id="lead">
            Team lead
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="who" value="manager" id="project">
            Product or project manager
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="who" value="engineer" id="engmanager">
            engineering manager
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="who" value="analysis" id="analytics">
            Analyst
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="who" value="data" id="datascience">
            Data science and machine learning
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="who" value="hr" id="hiremanager">
            HR
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="who" value="not-it" id="notit">
            I don't work in IT
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="who" value="sometingelse" id="another">
            Something else
          </label>
        </fieldset>
      </div>
      <div class="subscribe-settings__row">
        <fieldset class="subscribe-settings__fieldset">
          <legend class="subscribe-settings__label">Your experience level</legend>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="grade" value="student" id="start">
            I'm just starting to learn
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="grade" value="intern" id="firstlvl">
            Intern
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="grade" value="junior" id="secondlvl">
            Junior
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="grade" value="middle" id="thirdlvl">
            Mid-level
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="grade" value="senior" id="fourthlvl">
            Senior
          </label>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="radio" name="grade" value="master" id="fithlvl">
            Expert
          </label>
        </fieldset>
      </div>
      <div class="subscribe-settings__row">
        <fieldset class="subscribe-settings__fieldset">
          <legend class="subscribe-settings__label">I'm interested in:</legend>
          <label class="subscribe-settings__control-label">
            <input class="subscribe-settings__control" type="checkbox" name="interests" value="digest" id="base" checked>
            Doka Digest (monthly)
          </label>
        </fieldset>
        <p class="subscribe-settings__note">We're preparing new themed newsletters. We'll add more options over time, so you'll be able to choose more than just the monthly digest. We'll share updates in the digest.</p>
      </div>
      <div class="subscribe-settings__row subscribe-settings__row--center">
        <button class="subscribe-settings__button text-control__button button button--invert" type="submit">Subscribe</button>
        {# Update the messages below for each status #}
        <div class="subscribe__status">
          <p aria-live="polite" class="progress-text" id="subscribe-progress">Subscribing to the newsletter ⌛</p>
          <p aria-live="polite" class="success-text" id="subscribe-success">You're subscribed to the newsletter, hooray 🎉</p>
          <p aria-live="assertive" class="error-text" data-state="error" id="subscribe-error">Something went wrong. Reload the page and try subscribing again.</p>
        </div>
      </div>
    </form>

    <section class="unsubscribe-section">
      <form class="subscribe-page__unsubscribe subscribe-settings unsubscribe__form form-with-status" aria-labelledby="unsubscribe-label">
        <h2 class="subscribe-settings__title" id="unsubscribe-label">Unsubscribe from the newsletter <span aria-hidden="true">U×ᴥ×U</span></h2>
        <div class="unsubscribe__row">
          <div class="unsubscribe__field">
            <input type="text" name="reason" id="reason" class="unsubscribe__input subscribe-settings__input" placeholder="For example, I get too many emails">
            <label for="reason" class="unsubscribe__hint subscribe-settings__hint">Tell us what you didn't like</label>
          </div>
          <button class="subscribe-settings__button text-control__button button button--invert" type="submit">Unsubscribe</button>
        </div>
        {# Update the messages below for each status #}
        <div class="unsubscribe__status">
          <p aria-live="polite" class="progress-text" id="usubscribe-progress">Unsubscribing from the newsletter ⌛</p>
          <p aria-live="polite" class="success-text" id="usubscribe-success">You've unsubscribed from the newsletter ☹️</p>
          <p aria-live="assertive" class="error-text" data-state="error" id="usubscribe-error">Something went wrong. Reload the page and try unsubscribing again.</p>
        </div>
      </form>
    </section>
  </div>
</main>

{{ footer() }}

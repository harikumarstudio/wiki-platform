{% from "blocks/header.njk" import header with context %}
{% from "blocks/footer.njk" import footer with context %}

{{ header(isLogoImageHidden=true) }}

<main id="main-content">
  <div class="not-found font-theme font-theme--code">
    <div class="not-found__logo logo">
      <div class="logo__image" aria-hidden="true">
        <img src="/images/logo/logo-offline.svg" alt="Doka dog logo shown while offline">
      </div>
    </div>
    <p class="not-found__description">
      Doka is offline!<br>
      This article isn't available,<br>
      but here are some others:
    </p>
  </div>

  <div class="container">
    {% include "articles-gallery.njk" %}
  </div>
</main>

{{ footer() }}
